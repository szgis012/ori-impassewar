			[Bindable]
			private var model:ModelLocator = ModelLocator.getInstance();
			
			private var isPlayerNumKnown:Boolean = false,isGuildNumKnown:Boolean = false,isCityNumKnown:Boolean = false;
			
			[Bindable]
			private var countryType:ArrayCollection = new ArrayCollection(new Array("","自由联邦","联合帝国"));
			
			private function doInit():void{
				this.setFocus();
				this.addEventListener(KeyboardEvent.KEY_DOWN,WindowUtil.closeWindowPressEsc);
			}
			
			private function doClose():void{
				WindowUtil.closeWindow(this);
			}
			
			/**
			 * 显示玩家排名列表
			 */
			private function showPlayerRankList():void{
				if(!isPlayerNumKnown){
					this.getPlayerNum();
					isPlayerNumKnown = true;
				}
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowPlayerRankListEvent(model.playerInfo.playerID));
			}
			
			/**
			 * 根据玩家排名显示玩家排名列表
			 */
			private function showPlayerRankListByPlayerRank():void{
				if(textPlayerRank.text.length==0){
					MsgBox.showMessage("请输入玩家排名");
					return;
				}
				model.currentPlayerRank = parseInt(textPlayerRank.text);
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowPlayerRankListByPlayerRankEvent(model.currentPlayerRank));
			}
			
			/**
			 * 根据玩家名称显示玩家排名列表
			 */
			private function showPlayerRankListByPlayerName():void{
				if(StringUtil.trim(textPlayerName.text).length==0){
					MsgBox.showMessage("请输入玩家名称");
					return;
				}
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowPlayerRankListByPlayerNameEvent(textPlayerName.text));
			}
			
			/**
			 * 显示玩家排名上一页列表
			 */
			private function showPlayerRankPreviousPageList():void{
				if(model.currentPlayerRank>model.rankPageSize){
					model.currentPlayerRank = model.currentPlayerRank-model.rankPageSize;
					CairngormEventDispatcher.getInstance().dispatchEvent(new ShowPlayerRankListByPlayerRankEvent(model.currentPlayerRank));
				}
			}
			
			/**
			 * 显示玩家排名下一页列表
			 */
			private function showPlayerRankNextPageList():void{
				if(Math.ceil(model.currentPlayerRank/model.rankPageSize)<model.rankPlayerPageNum){
					model.currentPlayerRank = model.currentPlayerRank+model.rankPageSize;
					CairngormEventDispatcher.getInstance().dispatchEvent(new ShowPlayerRankListByPlayerRankEvent(model.currentPlayerRank));
				}
			}
			
