					<mx:DataGridColumn headerText="国家" dataField="country" width="90" textAlign="center" sortable="false" labelFunction="getPlayerCountry"/>
					<mx:DataGridColumn headerText="军衔" dataField="honor" width="80" sortable="false" />
					<mx:DataGridColumn headerText="声望" dataField="renown" width="120" textAlign="right" sortable="false" />
				</mx:columns>
			</mx:DataGrid>
			<mx:Label x="10" y="288" text="排名："/>
