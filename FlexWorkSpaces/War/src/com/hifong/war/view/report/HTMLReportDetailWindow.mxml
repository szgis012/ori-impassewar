<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml" layout="absolute" width="580" height="385" showCloseButton="false" close="doClose()" initialize="doInit()" move="onMove()" xmlns:common="com.hifong.war.view.common.*">
	
	<mx:Script>
		<![CDATA[
			import com.hifong.war.events.report.ReadReportEvent;
			import com.hifong.war.view.assets.WarAssets;
			import com.hifong.war.events.report.DeleteReportEvent;
			import com.hifong.war.events.report.SaveReportEvent;
			import com.hifong.war.constant.ReportTypeConstant;
			import com.hifong.war.vo.ReportVO;
			import com.hifong.war.events.message.DeleteMessageEvent;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import mx.events.FlexEvent;
			import com.hifong.war.util.MsgBox;
			import com.hifong.war.model.ModelLocator;
			import mx.managers.PopUpManager;
			
			import com.hifong.war.util.WindowUtil;
			import com.hifong.war.util.DateFormatUtil;
			
			
			private var _report:ReportVO;
			private var dispathcer:CairngormEventDispatcher = CairngormEventDispatcher.getInstance();
			
			
			[Bindable]
			public function set report(rpt:ReportVO):void{
				this._report = rpt;
				//如果报告还未读
				if(rpt.readFlag == 0){
					dispathcer.dispatchEvent(new ReadReportEvent([rpt.reportID]));
				}
			}
			
			public function get report():ReportVO{
				return this._report;
			}
			
			private function doInit():void{
				this.setFocus();
				this.addEventListener(KeyboardEvent.KEY_DOWN,WindowUtil.closeWindowPressEsc);
				html.source = report.content;
				html.visible = true;
			}
			
			private function doClose():void{
				html.visible = false
				WindowUtil.closeModelWindow(this);
			}
			
			private function onMove():void{
				html.moveIFrame();
			}
			
			//保存报告
			private function saveReport():void{
				dispathcer.dispatchEvent(new SaveReportEvent([report.reportID]));
			}
			
			//删除报告
			private function deleteReport():void{
				dispathcer.dispatchEvent(new DeleteReportEvent([report.reportID]));
				doClose();	
			}
			
		]]>
	</mx:Script>
	
	<mx:HBox width="100%" top="2" horizontalAlign="center" mouseChildren="false" mouseEnabled="false">
		<mx:Button id="titleBtn" styleName="Title" label="查看报告" width="{titleBtn.label.length*20+120}" />
	</mx:HBox>
	<mx:Button x="583" y="25" styleName="closeWindow" click="doClose()" right="10" top="6"/>
	
	<mx:Canvas x="25" y="37" width="530" height="320" styleName="CanvasBorder">
		<mx:Label x="10" y="12" text="标   题："/>
		<mx:TextInput id="textTitle" x="71" y="10" text="{report.title}" editable="false" width="449"/>
		<mx:Label x="10" y="43" text="类   型："/>
		<mx:TextInput id="textTitle0" x="71" y="41" text="{ReportTypeConstant.getTypeName(report.type)}" editable="false" width="449"/>
		<mx:Label x="10" y="75" text="时   间："/>
		<mx:TextInput x="71" y="73" text="{DateFormatUtil.formatDate(report.receiveTime)}" editable="false" width="449"/>
		<mx:Label x="10" y="103" text="内   容："/>
		<mx:Button x="71" y="284" label="保存" click="saveReport()" width="60" height="26"/>
		<mx:Button x="139" y="284" label="删除" click="deleteReport()" width="60" height="26" visible="false"/>
		<common:IFrame x="71" y="117" id="html" width="449" height="150">
		</common:IFrame>
		
	</mx:Canvas>
	
</mx:TitleWindow>
