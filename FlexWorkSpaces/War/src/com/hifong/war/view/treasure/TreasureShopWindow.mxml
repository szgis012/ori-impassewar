<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml" layout="absolute" width="650" height="465" showCloseButton="false" close="doClose()" xmlns:ns1="toy.treasure.*" initialize="doInit()" xmlns:ns2="com.hifong.war.view.treasure.*">
	<mx:Script>
		<![CDATA[
			import com.hifong.war.util.ConfigUtil;
			import com.hifong.war.view.assets.WarAssets;
			import com.hifong.war.events.treasure.GetRecommendTreasureListEvent;
			import com.hifong.war.constant.TreasureCategoryConstant;
			import com.hifong.war.events.treasure.GetTreasureListByCategoryEvent;
			import com.hifong.war.common.DialogManager;
			import com.hifong.war.constant.TreasureTypeConstant;
			import mx.collections.ArrayCollection;
			import mx.events.CollectionEvent;
			import com.hifong.war.vo.TreasureItemVO;
			import mx.events.IndexChangedEvent;
			import mx.managers.PopUpManager;
			import mx.binding.utils.ChangeWatcher;
			
			import com.hifong.war.util.WindowUtil;
			import com.hifong.war.model.ModelLocator; 
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			
			
			[Bindable]
			private var model:ModelLocator = ModelLocator.getInstance();
			private var treasureListWatcher:ChangeWatcher;
			//当前选择的选项卡 
			private var curpanel:Canvas;
			//当前显示的宝物类型
			private var curCategory:int;
			
			/** 是不是使用WindowUtil.showModelWindow方法弹出的模态窗口*/
			public var modelWindow:Boolean = false;
			
			/** 宝物列表类别 */
			public var treasureListCategory:int = 0;
			/** 宝物列表类型*/
			public var treasureListType:int=0;
			
			//初始化
			private function doInit():void{
				
				treasureListWatcher = ChangeWatcher.watch(model,"treasureShopList",doListChanged);
				
				if(treasureListCategory==0) {
					CairngormEventDispatcher.getInstance().dispatchEvent(new GetRecommendTreasureListEvent());
					//设置默认选项卡
					curpanel = this.recommendPanel;
				} else {
					this.curCategory = treasureListCategory;
					
					CairngormEventDispatcher.getInstance().dispatchEvent(new GetTreasureListByCategoryEvent(curCategory));
					switch(treasureListCategory) {
						case TreasureCategoryConstant.NORMAL:
							curpanel = this.treasurePanel;
							break;
						case TreasureCategoryConstant.ACCELERATE:
							curpanel = this.speedupPanel;
							break;
						case TreasureCategoryConstant.RESOURCE_PRODUCTION:
							curpanel = this.productionPanel;
							break;
						case TreasureCategoryConstant.TREASURE_BOX:
							curpanel = this.boxPanel;
							break;
						case TreasureCategoryConstant.MILITARY:
							curpanel = this.militaryPanel;
							break;
						case TreasureCategoryConstant.COMMANDER:
							curpanel = this.commanderPanel;
							break;
					}
				}
			}
			
			private function onCreationComplete():void {
				this.tabNavigator.selectedIndex = treasureListCategory;
			}
			
			private function doClose():void{
				if(modelWindow){
					WindowUtil.closeModelWindow(this);
				}else{
					WindowUtil.closeWindow(this);
				}
				
				treasureListWatcher.unwatch();
			}
			
			//更新数据
			private function doListChanged(arg:Object):void{
				showTreasure();
				
				if(model.treasureShopList){
					model.treasureShopList.addEventListener(CollectionEvent.COLLECTION_CHANGE,refreshPanel);
				}
			}
			
			//如果内容变化刷新视图
			private function refreshPanel(arg:Object):void{
				showTreasure();
			}
			
			//在canva容器内显示指定类型的宝物
			private function showTreasure():void{
				var tivo:TreasureItemVO;
				var row:int;
				var col:int;
				var j:int  = 0;
				var colsPerRow:int = 3;//一行显示多少列
				var offsetX:int = 5;
				var offsetY:int = 5;
				var ti:ShopTreasureItem;
				var treasureList:ArrayCollection = model.treasureShopList;
				
				if(!treasureList || treasureList.length==0)
					return;
	
				//缓存当前面板已经加载的宝物信息
				var cacheMap:Object = {};
				var itemNum:int = curpanel.numChildren;
				
				for(var k:int=0;k<itemNum;k++){
					ti = curpanel.getChildAt(k) as ShopTreasureItem;
					//key为宝物编号
					cacheMap[ti.treasureItem.treasureID] = ti;
					ti.visible = false;
				}
				
				for(var i:int=0; i<treasureList.length; i++){
					//TreasureItemVO对象
					tivo = treasureList.getItemAt(i)as TreasureItemVO ;
					
					ti = cacheMap[tivo.treasureID] as ShopTreasureItem;
					
					if(ti){
						cacheMap[tivo.treasureID] = null;
						ti.visible = true;
					}else{
						ti = new ShopTreasureItem();
						curpanel.addChild(ti);
					}
					
					ti.treasureItem = tivo;
					//calc x,y
					row = j / colsPerRow;
					col = j % colsPerRow;
					
					ti.x = (ti.width * col) + offsetX * col + offsetX;
					ti.y = (ti.height * row) + offsetY * row + offsetY;
					
					j++;
				}
			}
			
			private function doSelectChanged(event:IndexChangedEvent):void{
				this.curpanel = event.relatedObject as Canvas;
				
				//如果是推荐
				if(event.newIndex == 0){
					CairngormEventDispatcher.getInstance().dispatchEvent(new GetRecommendTreasureListEvent());
				}else{
					//这里假设tab的索引和宝物的分类值是一致的，如果调整任意一方必须同步变化
					curCategory = event.newIndex;
					CairngormEventDispatcher.getInstance().dispatchEvent(new GetTreasureListByCategoryEvent(curCategory));
				}
			}
			
			private function showMyTreasureWindow():void{
				var win:TreasureWindow = new TreasureWindow();
				this.doClose();
				WindowUtil.showWindow(win);
			}
			
			public function pay():void{
				ExternalInterface.call('window.open',ConfigUtil.getProperty("PAY_URL"),'_blank');
			}
			
		]]>
	</mx:Script>
	
	<mx:HBox width="100%" top="2" horizontalAlign="center" mouseChildren="false" mouseEnabled="false">
			<mx:Button id="titleBtn" styleName="Title" label="道具商城" width="{titleBtn.label.length*20+120}" /> 
		</mx:HBox>
	<mx:Button x="583" y="25" styleName="closeWindow" click="doClose()" right="10" top="6"/>
	
	<mx:TabNavigator width="600" height="352" id="tabNavigator" change="doSelectChanged(event)" x="25" y="42" creationComplete="onCreationComplete()">
		<mx:Canvas label="推荐" width="100%" height="100%" id="recommendPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on"  styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="宝物" width="100%" height="100%" id="treasurePanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="加速" width="100%" height="100%" id="speedupPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="生产" width="100%" height="100%" id="productionPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="宝箱" width="100%" height="100%" id="boxPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="军事" width="100%" height="100%" id="militaryPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
		<mx:Canvas label="指挥官" width="100%" height="100%" id="commanderPanel" horizontalScrollPolicy="off" verticalScrollPolicy="on" styleName="BugFixBorder">
		</mx:Canvas>
	</mx:TabNavigator>
	
	<mx:Canvas x="25" y="404" width="600" height="35" styleName="CanvasBorder">
		<mx:Label x="10" y="8" text="金币数量：" fontWeight="bold"/>
		<mx:Button x="168" y="6" label="充值" click="pay()"/>
		<mx:Button x="517" y="6" label="我的道具" click="showMyTreasureWindow()"/>
		<mx:TextInput x="88" y="7" width="72" editable="false" textAlign="right" text="{int(model.playerInfo.money)}"/>
	</mx:Canvas>
	
</mx:TitleWindow>
