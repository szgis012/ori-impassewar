<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml" initialize="doInit()" close="doClose()" layout="absolute" width="630" height="380" showCloseButton="false">
	<mx:Script>
		<![CDATA[
			import com.hifong.war.vo.DefenseVO;
			import com.hifong.war.view.assets.WarAssets;
			import mx.binding.utils.ChangeWatcher;
			import mx.collections.ArrayCollection;
			import com.hifong.war.util.CityDefenseUtil;
			import com.hifong.war.events.building.defense.FinishAllBuildDefenseEvent;
			import com.hifong.war.events.building.defense.CancelBuildDefenseEvent;
			import com.hifong.war.vo.BuildingVO;
			import com.hifong.war.common.CityDefenseInfo;
			import com.hifong.war.events.building.armory.CancelProduceOrdnanceEvent;
			import com.hifong.war.events.building.armory.ProduceOrdnanceEvent;
			import com.hifong.war.events.building.CancelProductionProcessEvent;
			import com.hifong.war.events.building.armory.FinishAllProduceProcessEvent;
			import com.adobe.cairngorm.control.CairngormEventDispatcher;
			import com.hifong.war.util.MsgBox;
			import com.hifong.war.util.DateFormatUtil;
			import com.hifong.war.vo.OrdnanceVO;
			import com.hifong.war.vo.CityOrdnanceVO;
			import com.hifong.war.vo.ProductionQueueVO;
			import com.hifong.war.model.ModelLocator;
			import com.hifong.war.common.CityDefenseInfo;
			import com.hifong.war.util.WindowUtil;
			
			
			private var model:ModelLocator = ModelLocator.getInstance();
			
			[Bindable]
			private var cityDefenseInfo:CityDefenseInfo = model.cityDefenseInfo;
			
			/** 监视城防建造队列的改变*/
			private var defenseProcessListWatcher:ChangeWatcher;
			
			
			private function doInit():void{
				defenseProcessListWatcher = ChangeWatcher.watch(model.cityDefenseInfo,"defenseProcessList",onDefenseProcessListChange);
			}
			
			//建造进程更改时的处理 
			private function onDefenseProcessListChange(event:Object):void{
				gridProcessList.dataProvider = getWaitedProcessList();
				this.lblTotalTime.text = getTotalTime();
			}
			
			//获得等待的进程列表
			private function getWaitedProcessList():ArrayCollection{
				var arr:ArrayCollection = new ArrayCollection();
				var processList:ArrayCollection = cityDefenseInfo.defenseProcessList;
				
				//跳过第一个(即正在建造的)进程
				if(processList && processList.length>1){
					for(var i:int=1; i<processList.length; i++){
						arr.addItem(processList.getItemAt(i));
					}
				}
				
				return arr;
			}
			
			private function doClose():void{
				defenseProcessListWatcher.unwatch();
				WindowUtil.closeModelWindow(this);
			}
			
			//获得防御名称
			private function getName(item:Object, column:DataGridColumn):String{
				var pp:ProductionQueueVO = item as ProductionQueueVO;
				var building:DefenseVO = CityDefenseUtil.getDefenseBuilding(cityDefenseInfo.getCityDefense(pp.targetID).defenseID);
				
				return building.name;
			}
			
			//获得建造所需时间
			private function getProduceTime(item:Object, column:DataGridColumn):String{
				var pp:ProductionQueueVO = item as ProductionQueueVO;
				var building:DefenseVO = CityDefenseUtil.getDefenseBuilding(cityDefenseInfo.getCityDefense(pp.targetID).defenseID);
				return "";
//				return DateFormatUtil.convertSecondToTime(building.nextConstraintDepend.costTime * pp.amount);
			}
			
			private function getFinishTime(item:Object, column:DataGridColumn):String{
				var pp:ProductionQueueVO = item as ProductionQueueVO;
				
				return DateFormatUtil.formatDate(pp.finishTime);
			}
			
			private function doFinishAllProduceProcess():void{
				//这里检查是否有相应的宝物，只有满足条件时才能进行本操作	
//				CairngormEventDispatcher.getInstance().dispatchEvent(new FinishAllBuildDefenseEvent());
			}
			
			public function doAccelerate(data:Object):void{
				MsgBox.showMessage("加速功能暂未开放！");
			}
			
			public function doCancel(data:Object):void{
				MsgBox.showConfirm("取消只返回部分资源，您确定要进行该操作吗？",function():void{
					CairngormEventDispatcher.getInstance().dispatchEvent(new CancelBuildDefenseEvent(data as ProductionQueueVO));
				});
				
			}
			
			private function getTotalTime():String{
				var defenseProcessList:ArrayCollection = model.cityDefenseInfo.defenseProcessList;
				
				if(defenseProcessList && defenseProcessList.length>0){
					//获得最后的进程,根据最后建造时间计算总剩余时间
					var process:ProductionQueueVO = defenseProcessList.getItemAt(defenseProcessList.length - 1) as ProductionQueueVO;
					var totalSeconds:Number = Math.max(0,Math.ceil((process.finishTime.time - model.serverTime.time )/1000));
					
					return  DateFormatUtil.convertSecondToTime(totalSeconds);
				}else{
					return "当前没有建造队列";
				}
				
			}
			
		]]>
	</mx:Script>
	
	<mx:HBox width="100%" top="2" horizontalAlign="center" mouseChildren="false" mouseEnabled="false">
		<mx:Button id="titleBtn" styleName="Title" label="等待建造的防御工事" width="{titleBtn.label.length*20+120}" />
	</mx:HBox>
	<mx:Button x="583" y="25" styleName="closeWindow" click="doClose()" right="10" top="6"/>
	
	<mx:Canvas x="25" y="37" width="580" height="320" styleName="CanvasBorder">
		<mx:DataGrid id="gridProcessList" x="10" y="10" width="560" height="273" dataProvider="{getWaitedProcessList()}" sortableColumns="false">
			<mx:columns>
				<mx:DataGridColumn headerText="名称" dataField="productionProcessID" labelFunction="getName" width="160"/>
				<mx:DataGridColumn headerText="数量" dataField="amount" width="70" textAlign="right"/>
				<mx:DataGridColumn headerText="生产时间" labelFunction="getProduceTime" width="110" textAlign="center"/>
				<mx:DataGridColumn headerText="结束时间" labelFunction="getFinishTime" width="140" textAlign="center"/>
				<mx:DataGridColumn headerText="操作" dataField="productionProcessID">
					<mx:itemRenderer>
						<mx:Component>
							<mx:HBox horizontalAlign="center" paddingLeft="7">
								<mx:Button height="24" label="取消" click="outerDocument.doCancel(data)"/>  
							</mx:HBox>
						</mx:Component>
					</mx:itemRenderer>
				</mx:DataGridColumn>
			</mx:columns>
		</mx:DataGrid>
		<mx:Label x="10" y="292" text="总计生产时间：" fontWeight="normal"/>
		<mx:Text x="93" y="292" id="lblTotalTime" text="{getTotalTime()}" width="178"/>
	</mx:Canvas>
	
</mx:TitleWindow>
