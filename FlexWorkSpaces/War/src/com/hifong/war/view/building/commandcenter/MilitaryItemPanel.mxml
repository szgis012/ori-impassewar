<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="100" height="120" styleName="ThirdBorder" useHandCursor="true" buttonMode="true" mouseChildren="false">
	<mx:Script>
		<![CDATA[
		
			/** 兵力信息*/
			[Bindable]
			public var militaryInfo:MilitaryInfo;
			
		]]>
	</mx:Script>
	<mx:Text x="9" y="91" text="{(militaryInfo.imgsrc)?militaryInfo.num:''}" width="80" textAlign="center" height="22"/>
	<mx:Image x="19" y="30" width="60" height="60" source="{militaryInfo.imgsrc}"/>
	<mx:Label x="9" y="10" text="{militaryInfo.armyName}" width="80" textAlign="center" fontWeight="bold"/>
</mx:Canvas>
