<?xml version="1.0" encoding="utf-8"?>
<mx:Canvas xmlns:mx="http://www.adobe.com/2006/mxml" width="400" height="150" initialize="doInit()">

	<mx:Script>
		<![CDATA[
			import com.hifong.war.view.military.MilitaryWindow;
			import mx.core.DragSource;
			import mx.managers.DragManager;
			import mx.managers.PopUpManager;
			import com.hifong.war.model.ModelLocator;
			import com.hifong.war.util.WindowUtil;
			
			private function doInit():void{
				this.addEventListener(KeyboardEvent.KEY_DOWN,onKeyDown);
				this.setFocus();
			}

			private function doClose():void{
				WindowUtil.closeModelWindow(this);
			}

			private function onKeyDown(event:KeyboardEvent):void{
				if(event.charCode==Keyboard.ESCAPE){
					doClose();
				}
			}
			/** 
			 * 招募指挥官
			 */
			private function showSelectedHeroWindow():void{
				doClose(); 
				var win:AddHerWindow=new AddHerWindow();
				WindowUtil.showModelWindow(win);
			}
			
		]]>
	</mx:Script>

	<mx:Canvas x="0" y="0" width="400" height="150" >
		<mx:backgroundImage>@Embed(source='images/msgbox_bg.png')</mx:backgroundImage>
	</mx:Canvas>
	
	<mx:Image x="30" y="30" source="images/msgbox_alert.png"/>
	<mx:Text x="115" y="30" id="labelContent"  htmlText="您还没有指挥官，请在“军事学院”招募。" width="265" height="67" fontSize="14"/>
	<mx:Button x="201" y="105" label="招募指挥官" click="showSelectedHeroWindow()"/>
	<mx:Button x="320" y="105" label="关 闭" height="25" width="60" click="doClose()"/>
	
</mx:Canvas>
