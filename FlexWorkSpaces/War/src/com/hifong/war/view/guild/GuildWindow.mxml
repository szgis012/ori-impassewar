				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildAttackListEvent(guildID,start,pageSize));
			}
			
			/**
			 * 显示工会攻击上一页列表
			 */
			private function showGuildAttackPreviousPageList():void{
				if(currentGuildAttackPageNum!=1){
					currentGuildAttackPageNum--;
					showGuildAttackList(currentGuildAttackPageNum);
				}
			}
			
			/**
			 * 显示工会攻击下一页列表
			 */
			private function showGuildAttackNextPageList():void{
				if(currentGuildAttackPageNum!=model.guildAttackPage){
					currentGuildAttackPageNum++;
					showGuildAttackList(currentGuildAttackPageNum);
				}
			}
			
			/**
			 * 初始化工会管理
			 */
			private function initGuildManage():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new InitGuildManageEvent(guildID,playerID));
			}
			
			
			/**
			 * 更新工会信息
			 */
			private function updateGuildInfo():void{
				var guild:GuildVO = new GuildVO();
				
				guild.guildID = guildID;
				guild.name = textGuildName_Manage.text;
				guild.introduction = textareaIntroduction_Manage.text;
				guild.notice = textareaNotice_Manage.text;
				
				CairngormEventDispatcher.getInstance().dispatchEvent(new UpdateGuildInfoEvent(guild));
			}
			
			/**
			 * 邀请加入工会
			 */
			private function inviteJoinGuild():void{
				
				var playerName:String = StringUtil.trim(textInvitePlayerName.text);
				
				if(playerName.length==0){
					MsgBox.showMessage("请输入玩家名称");
					return;
				}
				
				CairngormEventDispatcher.getInstance().dispatchEvent(new InviteJoinGuildEvent(guildID,playerName));
			}

			/**
			 * 同意玩家加入工会申请
			 */
			public function accpetPlayerJoinGuildApplication(playerID:int,guildID:int):void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new AccpetPlayerJoinGuildApplicationEvent(playerID,guildID));
			}
			
			/**
			 * 拒绝玩家加入工会申请
			 */
			public function refusePlayerJoinGuildApplication(playerID:int,guildID:int):void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new RefusePlayerJoinGuildApplicationEvent(playerID,guildID));
			}

			/**
			 * 取消邀请玩家
			 */
			public function cancelInvitePlayer(playerID:int,playerName:String):void{
				MsgBox.showConfirm("您确定要取消对玩家 " + playerName + " 的邀请吗？",function():void{
					CairngormEventDispatcher.getInstance().dispatchEvent(new CancelInvitePlayerEvent(guildID,playerID));
				});
			}
			
			/**
			 * 显示工会玩家申请邀请列表
			 */
			private function showGuildPlayerAppInvList():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildPlayerAppInvListEvent(guildID));
			}
			
			/**
			 * 根据玩家名称移除工会成员
			 */
			private function removeGuildMemberByPlayerName():void{
				var playerName:String = textRemoveMemberName.text
				if(StringUtil.trim(playerName).length==0){
					MsgBox.showMessage("请输入玩家名称");
					return;
				}else{
					if(model.guildVO.chairman.name==playerName){
						MsgBox.showMessage("无法将创始人移除");
						return;
					}else if(playerName==model.playerInfo.name){
						MsgBox.showMessage("无法将自己移除");
						return;
					}else{
						MsgBox.showConfirm("您确定要移除玩家 " + playerName + " 吗？",function ():void{
							CairngormEventDispatcher.getInstance().dispatchEvent(new RemoveGuildMemberByPlayerNameEvent(guildID,playerName));
						});
					}
				}
			}
			
			/**
			 * 移除工会玩家
			 */
			public function removeGuildMember(playerID:int,playerName:String):void{
				if(model.guildVO.chairmanID==playerID){
					MsgBox.showMessage("无法将创始人移除");
				}else if(playerID==model.playerInfo.playerID){
					MsgBox.showMessage("无法将自己移除");
					return;
				}else{
					MsgBox.showConfirm("您确定要移除玩家 " + playerName + "吗？",function ():void{
						CairngormEventDispatcher.getInstance().dispatchEvent(new RemoveGuildMemberEvent(guildID,playerID));
					});
				}
			}
			
			/**
			 * 显示工会玩家移除列表
			 */
			private function showGuildMemberRemoveList(pageNum:int):void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildMemberRemoveListEvent(guildID));
			}
			
			/**
			 * 添加工会关系
			 */
			private function addGuildRelationship():void{
				
				var targetGuildName:String = textGuildName_Relationship.text
	
				if(targetGuildName.length==0){
					MsgBox.showMessage("请输入军团名称");
					return;
				}
				if(radioRelationshipType_Manage.selection==null){
					MsgBox.showMessage("请选择类型");
					return;
				}
				
				var type:int = radioRelationshipType_Manage.selection.data as int;
				
				CairngormEventDispatcher.getInstance().dispatchEvent(new AddGuildRelationshipEvent(guildID,targetGuildName,type));
			}
			
			/**
			 * 显示工会关系列表
			 */
			private function showGuildRelationshipList():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildRelationshipListEvent(guildID));
			}
			
			/**
			 * 显示工会成员授权列表
			 */
			private function showGuildMemberGrantList(pageNum:int):void{
				
				currentGuildMemberGrantPageNum = pageNum;
				
				var start:int = (currentGuildMemberGrantPageNum-1)*pageSize;

				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildMemberGrantListEvent(guildID,start,pageSize));
			}
			
			/**
			 * 显示工会成员授权窗口
			 */
			public function showGuildMemberGrantWindow(playerID:int):void{
//				if(model.guildVO.chairmanID==playerID){
//					MsgBox.showMessage("创始人无法被授权");
//					return;
//				}
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildMemberGrantWindowEvent(guildID,playerID,this));
			}
			
			/**
			 * 显示玩家信息窗口
			 */
			public function showPlayerInfo(playerID:int):void{
				var win:ViewPlayerInfoWindow = new ViewPlayerInfoWindow();
				win.playerID = playerID;
				WindowUtil.showModelWindow(win);
			}
			
			/**
			 * 获得列攻击类型
			 */
			private function getColumnAttackType(item:Object, column:DataGridColumn):String{
				return attackType.getItemAt(item[column.dataField]).toString();
			}
			
			/**
			 * 获得列邀请类型
			 */
			private function getColumnInviteType(item:Object, column:DataGridColumn):String{
				return inviteType.getItemAt(item[column.dataField]).toString();
			}
			
			/**
			 * 获得列关系类型
			 */
			private function getColumnRelationshipType(item:Object, column:DataGridColumn):String{
				return relationshipType.getItemAt(item[column.dataField]).toString();
			}
			/////////////////////////////军团管理/////////////////////////////////
			private function guildManageSelectShow(temp:UIComponent):void{
				canvasGuildInfoManage.visible = false;
				transferOfficial.visible = false;
//				disbandGuild.visible = false;
				guildResearch.visible = false;
				upgradeGuild.visible = false;
				guildMessage.visible = false;
				canvasGuildOfficerManage.visible = false;
				
				canvasGuildMemeberAppInvManage.visible = false;
				canvasGuildMemeberRemoveManage.visible = false;
				canvasGuildRelationship.visible = false;
				
				temp.visible=true;
			}
			/**
			 * 获取可研究科技列表
			 */
			private function doGuildResearch():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new GetGuildTechnologyEvent(model.playerInfo.guildID));
			}
			/**
			 * 解散军团
			 */
			private function dismissGuild():void{
				
				MsgBox.showConfirm("您确定要解散军团吗？\n一旦解散军团所有军团相关信息将无法恢复，并且当前所有军团成员将全部退出。",function ():void{
					CairngormEventDispatcher.getInstance().dispatchEvent(new DismissGuildEvent(model.guildVO.guildID));
					doClose();
				});
				
			}
			/**
			 * 官员辞职
			 */
			private function showOfficalResign():void{
				MsgBox.showConfirm("您确定要辞职吗？\n辞职后的玩家，不再享有当前职位具备的权限，请玩家慎重考虑。",function ():void{
					if(model.guildVO.chairmanID==model.playerInfo.playerID){
						MsgBox.showMessage("创建人不能辞职，请先解散军团。");
						return;
					}
					var guildPlayerVO:GuildPlayerVO=new GuildPlayerVO();
					guildPlayerVO.guildID=model.playerInfo.guildID;
					guildPlayerVO.playerID=model.playerInfo.playerID;
					guildPlayerVO.dutyName="成员";
					guildPlayerVO.permission="0-0-0-0-0-0";
					CairngormEventDispatcher.getInstance().dispatchEvent(new GuildMemberGrantEvent(guildPlayerVO));
				});
			}
			/**
			 * 退出军团
			 */
			 private function showQuitGuildWindow():void{
			 	MsgBox.showConfirm("您确定要推出军团吗？\n玩家退出军团后，将不再受到军团的保护，24小时内也不得再加入其他军团。",function ():void{
			 		CairngormEventDispatcher.getInstance().dispatchEvent(new ExitGuildEvent(model.playerInfo.playerID));
			 		doClose();
			 	});
			 }
			 /**
			 * 研究科技
			 */
			 public  function upgradeTechnology(data:Object):void{ 
			 	CairngormEventDispatcher.getInstance().dispatchEvent(new UpgradeTechnologyEvent(model.guildVO.guildID,int(data.technologyID))); 
			 }
			 /**
			 * 升级军团
			 */
			 private function upgradeGuildHandler():void{
			 	CairngormEventDispatcher.getInstance().dispatchEvent(new UpgradeGuildEvent(model.guildVO.guildID));
			 }
			 /**
			 * 军团外交-解除关系
			 */
			public function removeGuildRelationship(data:Object):void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new RemoveGuildRelationshipEvent(model.guildVO.guildID,data.targetGuild.name));
			}
			////////////////////////////军团操作/////////////////////////////////
			/**
			 *  军团操作  选择界面
			 */
			 private function guildOperatoinSelectShow(temp:UIComponent):void{
			 	guildOperationDefault.visible=false;
			 	guildContribute.visible=false;
			 	guildSubsidy.visible=false;
			 	guildFight.visible=false;
			 	temp.visible=true;
			 }
			 /**
			 * 获取军团收入明细情况
			 */
			private function getGuildIncomeInfo():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new GetTotalAlmsOfGuildMemberInGuildEvent(model.guildVO.guildID,0,1));
//				CairngormEventDispatcher.getInstance().dispatchEvent(new GetAllGuildIncomeInfoEvent(model.playerInfo.guildID));
			}
			/**
			 * 捐献金钱
			 */
			private function donateMoney():void{
				if(StringUtil.trim(moneyTxt.text)=="") return;
			 	if(Number(StringUtil.trim(moneyTxt.text))==0) return;
			 	if(Number(StringUtil.trim(moneyTxt.text))>model.cityInfo.cityResource.moneyNum){
			 		MsgBox.showMessage("您拥有的金钱数不足。");
			 		return;
			 	}
				CairngormEventDispatcher.getInstance().dispatchEvent(new DonateMoneyEvent(model.playerInfo.guildID,model.playerInfo.playerID,Number(moneyTxt.text)));
			}
			private const bannerSelectAC:ArrayCollection=new ArrayCollection(GuildConfig.oriflammeTypeArray);
			/**
			 * 获取自身旗帜数量
			 */
			 private function getBannerNum(index:int):int{
			 	return GuildConfig.playerOriflammeArray[index];
			 }
		 /**
		 * 捐献旗帜
		 */
		 private function donateOriflamme():void{
				if(StringUtil.trim(bannerTxt.text)=="") return;
				if(Number(StringUtil.trim(bannerTxt.text))==0) return;
				if(Number(bannerTxt)>getBannerNum(bannerSelect.selectedIndex)){
					MsgBox.showMessage("您拥有的旗帜数量不足。");
					return;
				}
				CairngormEventDispatcher.getInstance().dispatchEvent(new DonateOriflammeEvent(model.playerInfo.guildID,model.playerInfo.playerID,"XXX",int(bannerTxt.text)));
		 }
		 /**
		 * 获取成员捐献旗帜情况
		 */
		 private function getDonateOriflamme(data:Object,column:DataGridColumn):String{
		 	var s:String;
		 	if(data["guildIncExpHistory"]==null){
		 		return "0士官军旗; 0 校官军旗; 0 元帅军旗数量";
		 	}
		 	s=data["guildIncExpHistory"]["oriflammeLowerNum"]+"士官军旗;";
		 	s+=data["guildIncExpHistory"]["oriflammeIntermediateNum"]+" 校官军旗;";
		 	s+=data["guildIncExpHistory"]["oriflammeAdvancedNum"]+" 元帅军旗";
		 	return s;
		 }
		 /**
		 * 获取成员捐献金钱
		 */
		 private  function getDonateMoney(data:Object,column:DataGridColumn):String{
		 	if(data["guildIncExpHistory"]==null){
			 	return "0";
		 	}
	 		return data["guildIncExpHistory"]["money"];
		 }
		 /**
		 * 领取军团补贴
		 */
		 private function receiveSubsidy():void{
		 	CairngormEventDispatcher.getInstance().dispatchEvent(new ReceiveSubsidyEvent(model.guildVO.guildID,model.playerInfo.playerID));
		 }
		]]>
	</mx:Script>
	<mx:TabNavigator id="tabGuild" x="25" y="37" width="580" height="375">
		<mx:Canvas label="军团概况" width="100%" height="100%" initialize="showGuildInfo()" styleName="ContentCanvas">
			<mx:Label x="10" y="10" text="军团名称：{model.guildVO.name}" width="169.5"/>
			<mx:Label x="10" y="66" text="创 始 人 ：{model.guildVO.chairman.name}" width="169.5"/>
			<mx:Label x="187.5" y="38" text="成员人数：{model.guildVO.population}/{model.guildVO.populationMax}" width="179.5"/>
			<mx:Label x="187.5" y="10" text="当前排名：{model.guildVO.rank}"/>
			<mx:Label x="187.5" y="66" text="军团声望：{model.guildVO.renown}"/>
			<mx:Label x="10" y="38" text="军团等级 ：{model.guildVO.level}" width="169.5"/>
			<mx:Label x="187.5" y="94" text="军团荣誉：{model.guildVO.contribution}"/>
			<!--工会介绍-->
			<mx:TextArea x="10" y="122" height="90" width="357" editable="false" htmlText="{model.guildVO.introductionDescription}" />
			<!--工会公告-->
			<mx:TextArea x="10" y="220" height="107" width="357" editable="false" htmlText="{model.guildVO.noticeDescription}" />
			<!--工会关系描述-->
			<!--<mx:TextArea x="375" y="9" height="318" width="193" editable="false" htmlText="{model.guildVO.relationshipDescription}" verticalScrollPolicy="on"/>-->
			<!--联盟外交-->
				<mx:TextArea x="375" y="10" height="317" width="193" htmlText="{model.guildVO.relationshipDescription}">
				</mx:TextArea>
		</mx:Canvas>
		
		<mx:Canvas label="成员列表" width="100%" height="100%" initialize="showGuildMemberList(1)" styleName="ContentCanvas">
			<mx:DataGrid x="10" y="10" dataProvider="{model.guildMemberList}" width="558" height="287">
				<mx:columns>
					<mx:DataGridColumn headerText="名称" dataField="player.name" sortable="false" labelFunction="DataGridUtil.getColumnProperty" />
					<mx:DataGridColumn headerText="职位" dataField="dutyName" sortable="false" textAlign="center" />
					<mx:DataGridColumn headerText="军衔" dataField="player.honorName" sortable="false" textAlign="center" labelFunction="DataGridUtil.getColumnProperty"  />
					<mx:DataGridColumn headerText="声望" dataField="player.renown" sortable="false" textAlign="right" labelFunction="DataGridUtil.getColumnProperty" />
