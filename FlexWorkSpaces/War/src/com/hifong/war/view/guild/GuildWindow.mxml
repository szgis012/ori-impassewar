			private var pageSize:int = model.messagePageSize;
			
			[Bindable]
			private var attackType:ArrayCollection = new ArrayCollection(new Array("","攻击","防御"));
			[Bindable]
			private var inviteType:ArrayCollection = new ArrayCollection(new Array("","申请加入","邀请加入"));
			[Bindable] 
			private var relationshipType:ArrayCollection = new ArrayCollection(new Array("","友好","敌对"));
			
			private function doInit():void{
				this.setFocus();
				this.addEventListener(KeyboardEvent.KEY_DOWN,WindowUtil.closeWindowPressEsc);

				tabGuild.selectedIndex = 4;
				tabGuild.selectedIndex = -1;
			}
			
			private function doClose():void{
				WindowUtil.closeWindow(this);
			}
			
			/**
			 * 显示工会信息
			 */
			private function showGuildInfo():void{
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildInfoEvent(model.playerInfo.guildID));
			} 
			
			/**
			 * 显示工会成员列表
			 */
			private function showGuildMemberList(pageNum:int):void{
				
				currentGuildMemberPageNum = pageNum;
				
				var start:int = (currentGuildMemberPageNum-1)*pageSize;
				
				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildMemberListEvent(guildID,start,pageSize));
			}
			
			/**
			 * 显示工会成员上一页列表
			 */
			private function showGuildMemberPreviousPageList():void{
				if(currentGuildMemberPageNum!=1){
					currentGuildMemberPageNum--;
					showGuildMemberList(currentGuildMemberPageNum);
				}
			}
			
			/**
			 * 显示工会成员下一页列表
			 */
			private function showGuildMemberNextPageList():void{
				if(currentGuildMemberPageNum!=model.guildMemberPage){
					currentGuildMemberPageNum++;
					showGuildMemberList(currentGuildMemberPageNum);
				}
			}
			
			/**
			 * 显示工会事件列表
			 */
			private function showGuildEventList(pageNum:int):void{
				
				currentGuildEventPageNum = pageNum;
				
				var start:int = (currentGuildEventPageNum-1)*pageSize;

				CairngormEventDispatcher.getInstance().dispatchEvent(new ShowGuildEventListEvent(guildID,start,pageSize));
			}
			
			/**
