<?xml version="1.0" encoding="utf-8"?>
<mx:TitleWindow xmlns:mx="http://www.adobe.com/2006/mxml" width="430" height="248"  layout="absolute" showCloseButton="false">
	<mx:Script>
		<![CDATA[
			import com.hifong.war.view.assets.WarAssets;
			import mx.managers.PopUpManager;
			import com.hifong.war.view.building.commandcenter.MilitaryCommandWindow;
			import com.hifong.war.model.ModelLocator;
			import com.hifong.war.common.WorldInfo;
			import com.hifong.war.vo.MapVO;
			import com.hifong.war.util.WindowUtil;
			
			private var worldInfo:WorldInfo = ModelLocator.getInstance().worldInfo;
			
			private var _gridInfo:MapVO;
						
			public function set gridInfo(map:MapVO):void{
				this._gridInfo = map;
				
				this.pnlImg.setStyle("backgroundImage", worldInfo.worldAssets.backgroundImage);
				titleBtn.label = "要塞("+map.posX+","+map.posY+")";
				this.img.source = new worldInfo.worldAssets.terrainImages[map.category+"_"+map.type]();
			}
			
			private function doSpy():void{
				showActionWindow(0);
			}
			
			private function doAttack():void{
				showActionWindow(1);
			}
			
			private function doDispatch():void{
				showActionWindow(2);
			}
			
			//1 侦察, 2攻击 ,3 派遣
			private function showActionWindow(type:int):void{
				var win:MilitaryCommandWindow = new MilitaryCommandWindow();
				win.posX = _gridInfo.posX;
				win.posY = _gridInfo.posY;
				//TODO type的值
				win.commandSelectedIndex = type;
				
				WindowUtil.showModelWindow(win);
			}
			
			private function doClose():void{
				worldInfo.hasDisplayedWindow = false;
				this.visible = false;
//				WindowUtil.closeWindow(this);
			}
		]]>
	</mx:Script>
	
	<mx:HBox width="100%" top="2" horizontalAlign="center" mouseChildren="false" mouseEnabled="false">
		<mx:Button id="titleBtn" styleName="Title" label="要 塞" width="{titleBtn.label.length*20+120}" />
	</mx:HBox>
	<mx:Button x="583" y="25" styleName="closeWindow" click="doClose()" right="10" top="6"/>
	
	<mx:Canvas x="25" y="37" width="380" height="96" styleName="CanvasBorder">
		<mx:Canvas x="10" y="10" width="100" height="75" id="pnlImg">
			<mx:Image x="0" y="0" width="100" height="75" id="img" />
		</mx:Canvas>
		<mx:TextArea x="118" y="10" width="252" height="75" id="txtDesc" editable="false"/>
	</mx:Canvas>
	<mx:Canvas width="380" height="80" styleName="CanvasBorder" x="25" y="141">
		<mx:Button x="10" y="44" label="进入" width="60" height="26"/>
		<mx:Button x="78" y="44" label="派遣" click="doDispatch()" width="60" height="26"/>
		<mx:Button x="146" y="44" label="放弃" width="60" height="26"/>
		<mx:Button x="10" y="10" label="侦察" click="doSpy()" width="60" height="26"/>
		<mx:Button x="78" y="10" label="宣战" width="60" height="26"/>
		<mx:Button x="146" y="10" label="攻击" click="doAttack()" width="60" height="26"/>
	</mx:Canvas>
	
</mx:TitleWindow>
