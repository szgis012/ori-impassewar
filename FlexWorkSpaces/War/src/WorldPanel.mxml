			/**
			 * 按地图设置屏幕坐标
			 */
			private function setGridPosition(wg:WorldGrid):void{
				var point:Point=getScreenPostion(new Point(wg.posX,wg.posY));
				//计算偏移量
				wg.x=point.x-edgeWidth/2;
				wg.y=point.y-edgeHeight/2-IMG_OFFSETY;
			}
			/**
			 * 根据地图坐标换算为屏幕坐标（地图中心点）
			 */
			private function getScreenPostion(point:Point):Point{
				var tx:int=point.x;
				var ty:int=point.y;
				
				var vx:Number;
				var vy:Number;
				//邻短边
				var a:Number=Math.min(tx,ty)*edgeLong;
				//邻长边
				var b:Number=Math.max(tx,ty)*edgeLong;
				//余弦定理
				var c:Number=Math.sqrt(a*a+b*b -2*a*b*Math.cos(2*offsetAngle));
				var cosA:Number=(b*b+c*c-a*a)/(2*b*c); 
				var angleA:Number=Math.acos(cosA);
				vx=c* Math.cos(angleA+offsetAngle);
				vy=c* Math.sin(angleA+offsetAngle); 
				if(tx==ty){
					vx=0;
					vy=tx*edgeHeight;
				}else if(tx<ty){ 
					vx *=-1;
				}
				//	        	trace("A:"+a+" B:"+b+" C:"+c+" angleA:"+angleA+"vx:"+vx+" vy:"+vy);
				return new Point(vx,vy);
			}
			/**
			 * 根据中心点获取所需屏幕地图坐标集合
			 */
			private function getAllPointByCenterPoint(p:Point):void{
				var moveX:Number;
				var moveY:Number;
				allMapPointList.length=0;
				allMapPoint={ };
				var pp:Point;
				
				//左上
				for(moveX=p.x;moveX>p.x-OFFSETX*screenMoveX;moveX-=edgeWidth){
					for(moveY=p.y;moveY>p.y-OFFSETY*screenMoveY;moveY-=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				for(moveX=p.x-edgeWidth*0.5;moveX>p.x-OFFSETX*screenMoveX;moveX-=edgeWidth){
					for(moveY=p.y-edgeHeight*0.5;moveY>p.y-OFFSETY*screenMoveY;moveY-=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				//左下
				for(moveX=p.x;moveX>p.x-OFFSETX*screenMoveX;moveX-=edgeWidth){
					for(moveY=p.y;moveY<p.y+OFFSETY*screenMoveY;moveY+=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				for(moveX=p.x-edgeWidth*0.5;moveX>p.x-OFFSETX*screenMoveX;moveX-=edgeWidth){
					for(moveY=p.y+edgeHeight*0.5;moveY<p.y+OFFSETY*screenMoveY;moveY+=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				//右上
				for(moveX=p.x;moveX<p.x+OFFSETX*screenMoveX;moveX+=edgeWidth){
					for(moveY=p.y;moveY>p.y-OFFSETY*screenMoveY;moveY-=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				for(moveX=p.x+edgeWidth*0.5;moveX<p.x+OFFSETX*screenMoveX;moveX+=edgeWidth){
					for(moveY=p.y-edgeHeight*0.5;moveY>p.y-OFFSETY*screenMoveY;moveY-=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				//右下
				for(moveX=p.x;moveX<p.x+OFFSETX*screenMoveX;moveX+=edgeWidth){
					for(moveY=p.y;moveY<p.y+OFFSETY*screenMoveY;moveY+=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
				for(moveX=p.x+edgeWidth*0.5;moveX<p.x+OFFSETX*screenMoveX;moveX+=edgeWidth){
					for(moveY=p.y+edgeHeight*0.5;moveY<p.y+OFFSETY*screenMoveY;moveY+=edgeHeight){
						pp=getMapPostion(new Point(moveX,moveY));
						if(pp!=null && allMapPoint[WorldUtil.getIndexFromXY(moveX,moveY)] ==null ){
							allMapPoint[WorldUtil.getIndexFromXY(pp.x,pp.y)]=pp;
							allMapPointList.push(pp);
						}
					}
				}
//				trace(allMapPointList.length);
			}
