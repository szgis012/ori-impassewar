			/** 添加网格 */
			public function addGrid(arr:Array):void{
				var time:Number=new Date().time;
				if(arr==null || arr.length==0) return ;	
				//网格
				var wg:WorldGrid;
				var obj:Object=worldInfo.gridInfoMap;
				var index:int;
				//设定坐标
				if(haveSetPostion){
					haveSetPostion=false;
					setGridPanelByCertenPoint(new Point(worldInfo.mapX,worldInfo.mapY)); 
				}
				for each( var map:MapVO in arr){
						wg = new WorldGrid();
						index=WorldUtil.getIndexFromXY(map.posX,map.posY);
						wg.posX=map.posX;
						wg.posY=map.posY;
						var cate:int=map.category;
						if(map.category == MapCategoryConstant.MONSTERFIELD){
							wg.addImg((new worldInfo.worldAssets.terrainImages[map.category+"_"+map.type]() as Bitmap).bitmapData);
							cate=0;
						}
						wg.source=(new worldInfo.worldAssets.terrainImages[cate+"_"+map.type] as Bitmap).bitmapData;
						gridPanel.addChild(wg);  
						if(obj[index]==null) obj[index]=map;
						setGridPosition(wg);
					}
					//设置深度。。。todo
				//移除加载数据的图标
				cursorManager.removeAllCursors();
				var now:Number=new Date().time;
				deleteGrid(deletePointList);
				resetIndex();
				moveLocked=false;
				trace("use:"+(now-time));
				trace(new Date().time);
			}
			/** 删除网格 */
			public function deleteGrid(arr:Array):void{
				var wg:WorldGrid;
				var obj:Object=worldInfo.gridInfoMap;
				for each(var map:MapVO in arr){
					wg=getGridByPostion(new Point(map.posX,map.posY));
					if(wg!=null){
						gridPanel.removeChild(wg);
						wg=null;
					}
				}
				allMapPoint={ };
				
				deletePointObj={ };
				deletePointList=[ ];
			}
			/**
			 * 重设深度
			 */
			private function resetIndex():void{
				var arr:Array=gridPanel.getChildren();
				arr.sortOn(["posX","posY"],[Array.NUMERIC,Array.NUMERIC]);
				for(var i:int=0;i<gridPanel.numChildren;i++){
					gridPanel.setChildIndex(arr[i],i);
				}
			}
			/**
			 * 根据地图点返回在gridPanel网格
			 */
			private function getGridByPostion(p:Point):WorldGrid{
				var index:int=WorldUtil.getIndexFromXY(p.x,p.y);
				for each(var wg:WorldGrid in gridPanel.getChildren()){
					if(WorldUtil.getIndexFromXY(wg.posX,wg.posY)==index) return wg;
				}
				return null;
			}
