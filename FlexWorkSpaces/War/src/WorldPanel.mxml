			private function showStrongHoldWindow(map:MapVO):void{
				this.cityWindow.visible = false;
				this.wildLandWindow.visible = false;
				this.strongHoldWindow.gridInfo = map;
				this.strongHoldWindow.visible = true;
			}
			
			//显示野地窗口
			private function showWildLandWindow(map:MapVO):void{
				this.strongHoldWindow.visible = false;
				this.cityWindow.visible = false;
				this.wildLandWindow.gridInfo = map;
				this.wildLandWindow.visible = true;
			}
			/**
			 * 	将屏幕坐标转换成地图坐标
			 */
			private function getMapPostion(p:Point):Point
			{
				var pt:Point=new Point(p.x,p.y);
				var nip:Number=Math.atan2(pt.y, pt.x);
				nip < 0 ? nip*=-1 : null;
				var angleA:Number=nip - offsetAngle;
				var angleB:Number=2 * offsetAngle;
				if (pt.x < 0)
				{
					angleA=Math.PI - offsetAngle - nip;
				}
				var AC:Number=Math.sqrt(pt.x * pt.x + pt.y * pt.y);
				var CD:Number=AC * Math.sin(angleA);
				var BC:Number=CD / Math.sin(angleB);
				var AB:Number=BC * Math.cos(angleB) + AC * Math.cos(angleA);
				var ox:int=AB / (edgeLong * 0.5) >> 0;
				var tx:int=ox % 2 + ox / 2 >> 0;
				var oy:int=BC / (edgeLong * 0.5) >> 0;
				var ty:int=oy % 2 + oy / 2 >> 0;
				if (pt.x < 0)
				{
					var trans:int=ty;
					ty=tx;
					tx=trans;
				}
				return new Point(tx, ty);
			}
			//移动地图
			private function moveViewTo(mapX:int, mapY:int) : void
			{
				if (!moveLocked)
				{
					
					var now:Date = new Date();
					
					//间隔至少1秒
					if ((now.time - lastMoveTime.time) < 1000)
					{
						return;
					}
					
					lastMoveTime = now;
					
					cursorManager.setBusyCursor();
					
					worldInfo.loadMapData(mapX,mapY);
					
					moveLocked = true;
				}
			}			
			
