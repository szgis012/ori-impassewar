			/**
			 * 鼠标按下时的处理函数
			 */
			private function onMouseClick(event:MouseEvent) : void
			{
				//	        	//如果处在拖动状态就返回
				//	        	if(isDrag){
				//	        		return;
				//	        	}
				if(moveLocked || noClick){
					return;
				}
				
				this.pnlToolTip.visible = false;
				
				//获得网格的信息
				var map:MapVO = getMapData(event);
				
				//如果超出有效地图范围
				if(!map)
					return;
				
				//设置窗口打开标志
				worldInfo.hasDisplayedWindow = true;
				
				switch(map.type){
					//如果是城市
					case 1:
						showCityWindow(map);
						break;
					//如果是要塞	
					case 2:
						showStrongHoldWindow(map);
						break;	
					default:
						showWildLandWindow(map);
						break;
				}
				isDown=false;
			}
			
			private function doDrag(event:MouseEvent):void{
				var gpt:Point = new Point(event.stageX,event.stageY);
				var pt:Point;
				
				//开始拖动初始化
				if(!isDrag){
					//计算拖动时的鼠标位置和拖动目标的偏移距离
					pt = this.globalToLocal(gpt);
					dragStartPos = new Point(gpt.x,gpt.y);
					startDragTime=new Date().time;
					
					dragOffsetX = pt.x - gridPanel.x;
					dragOffsetY = pt.y - gridPanel.y;
					//设置拖动目标的透明度和鼠标样式
					cursorManager.setCursor(MoveIcon);
					//设置拖动状态
					isDrag = true;
					var rect:Rectangle=gridPanel.getBounds(this);
//					drawStartPoint.x=rect.x;
//					drawStartPoint.y=rect.y;
					trace("startDrag:"+rect);
				}
				
				//鼠标在容器内的坐标
				pt = this.globalToLocal(gpt);
				
				gridPanel.x = pt.x-dragOffsetX ;
				gridPanel.y = pt.y-dragOffsetY ;
				
				//判断拖动距离大于半屏则加载数据
				if(Math.sqrt(Math.pow(gpt.x-dragStartPos.x,2)+Math.pow(gpt.y-dragStartPos.y,2))>OFFSETY){
					doEndDrag(event);
				}
				//当拖动时间大于限制时间
				if(new Date().time-startDragTime>limitDragTime){
					doEndDrag(event);
				}
				event.updateAfterEvent(); 
			}
			
			//结束拖动
			private function doEndDrag(event:MouseEvent):void{
				//如果不在拖动状态就返回
				if(!isDrag){
					return;
				}
				cursorManager.removeAllCursors();
				isDrag = false;
				isDown=false;
				noClick=true;
				moveLocked=true;
				
				trace("endDrag:"+gridPanel.getBounds(this)); 
				var rectEnd:Rectangle=gridPanel.getBounds(this);
				
				//				var rectH:Rectangle, rectV:Rectangle, rectDH:Rectangle, rectDV:Rectangle;
				var vx:Number=rectEnd.x-drawStartPoint.x;
				var vy:Number=rectEnd.y-drawStartPoint.y;
				//如果没用有效拖动
				if(vx==0&& vy==0) return;
				
				var point:Point=getMapPostion(new Point(OFFSETX-gridPanel.x,OFFSETY-gridPanel.y));
				startTime=new Date().time;
				callMapDataByCenterPoint(point);
				
				event.stopPropagation();
				event.stopImmediatePropagation();
//				trace(new Date().time-startHandlerTime); 
			}
			/**
			 * 根据地图中心点请求数据
			 */
			public  function callMapDataByCenterPoint(p:Point,hasSetAsCenterPostion:Boolean=false):void{
				var now:Date = new Date();
				//间隔至少1秒
				if ((now.time - lastMoveTime.time) < 1000) return;
				lastMoveTime = now;
				
				haveSetPostion=hasSetAsCenterPostion;
				var mx:int=p.x;
				var my:int=p.y;
				mx = Math.min(mx,worldInfo.MAX_RANGE_X);
				my = Math.min(my,worldInfo.MAX_RANGE_Y);
				mx=Math.max(mx,worldInfo.MIN_RANGE_X);
				my=Math.max(my,worldInfo.MIN_RANGE_Y);
				
				worldInfo.mapX=mx;
				worldInfo.mapY=my;
				
				var point:Point=getScreenPostion(p); 
				getAllPointByCenterPoint(point);
				collectionOperationPoint();
//				trace(requestPointList.length);
				
				startTime=lastMoveTime.time;
//				moveLocked = true;
				
				//请求数据
				worldInfo.requestMapXY(requestPointList,hasSetAsCenterPostion); 
				//清空请求数据
				requesetPointObj={ };
				requestPointList.length=0;
			}
			/**
			 * 收集请求和待删除的地图点
			 */
			private function collectionOperationPoint( ):void{
				var nowPoints:Object=worldInfo.gridInfoMap;
				for (var item:String in nowPoints){
					var map:MapVO=nowPoints[item];
					if(map==null) continue;
					var index:int=WorldUtil.getIndexFromXY(map.posX,map.posY);
					//所需的屏幕中无此点
					if(allMapPoint[index]==null){
						deletePointList.push(map);
						delete nowPoints[index];
					}else if(allMapPoint[index]!=null){
						//已有此点 则从请求节点中删掉
						delete allMapPoint[index];
					}
				} 
				//统计请求节点
				requestPointList=[ ];
				for(var t:String in allMapPoint){
					var p:Point=allMapPoint[t] as Point;
					if(p!=null) 	requestPointList.push(p);
				}
			}
			
			private function onMouseDown(event:MouseEvent):void{
				if(!(event.target is Canvas)) return ;
				isDown=true;
				noClick=false;
			}
			private function onMouseMove(event:MouseEvent):void{
				//如果有打开的窗口就不显示tooltip
				if(worldInfo.hasDisplayedWindow)
					return;
				
				//换算到屏幕坐标
				var pt:Point = tipPanel.localToGlobal(new Point(controlPanel.x,controlPanel.y));
				//如果在控制面板范围内上
				if (event.stageX >= pt.x && event.stageX < pt.x + controlPanel.width && event.stageY >= pt.y && event.stageY < pt.y + controlPanel.height){
					this.pnlToolTip.visible = false;
					return;
				}
				//如果处在鼠标按下或者拖动状态
				if(isDown || isDrag){
					event.buttonDown=false;
					this.pnlToolTip.visible = false;
					doDrag(event);
					return;
				}
				
				
				//获得网格的信息
				var map:MapVO = getMapData(event);
				
				//如果超出有效地图范围
				if(!map)
					return;
				
				this.pnlToolTip.gridInfo = map;
				
				//转换为相对于tooltip面板的坐标
				pt = this.tipPanel.globalToLocal(new Point(event.stageX,event.stageY));
				//tooltip X坐标偏移
				pt.x += 20;
				
				if( (pt.x+this.pnlToolTip.width) > this.width){
					pt.x -= (this.pnlToolTip.width +40);
				}
				
				if( (pt.y+this.pnlToolTip.height) > this.height){
					pt.y -= this.pnlToolTip.height;
				}
				
				this.pnlToolTip.x = pt.x;
				this.pnlToolTip.y = pt.y;
				
				this.pnlToolTip.visible	 = true;
				
//				event.updateAfterEvent();
			}
			
			//得到鼠标位置处的MapVO对象
			private function getMapData(event:MouseEvent):MapVO{
				//换算到屏幕坐标
				var pt:Point = tipPanel.localToGlobal(new Point(controlPanel.x,controlPanel.y));
				//如果在控制面板范围内上
				if (event.stageX >= pt.x && event.stageX < pt.x + controlPanel.width && event.stageY >= pt.y && event.stageY < pt.y + controlPanel.height)
					return null;
				
				var pp:Point=getMapPostion(new Point(event.localX-gridPanel.x,event.localY-gridPanel.y));
				var map: MapVO=worldInfo.gridInfoMap[WorldUtil.getIndexFromXY(pp.x,pp.y)] as MapVO;
				//获得网格的信息
				return map;
			}
			
