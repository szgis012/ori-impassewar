			public function showLoginWindow(event:Object):void{
				
				var count:int = 0;
				var handle:Number = setInterval(function ():void{
					//配置文件是否加载完成
					if(ConfigUtil.haveInited){
						
						model.SERVER_IP = ConfigUtil.getProperty("SERVER_IP");
						model.SERVER_ENDPOINT = ConfigUtil.getProperty("SERVER_ENDPOINT");
						model.LOGIN_WEBSERVICE_WSDL = ConfigUtil.getProperty("LOGIN_WEBSERVICE_WSDL");
						
						var win:LoginWindow = new LoginWindow();
						model.loginWindow = win;
						PopUpManager.addPopUp(win,model.app,false);
						PopUpManager.centerPopUp(win);
							
						clearInterval(handle);
	
					}
					count++;
					if(count>50){
						clearInterval(handle); 
						MsgBox.showMessage("加载配置文件失败，请刷新浏览器重试。");
					}
				}, 100);
				
			}
			
			public function showCity(event:MouseEvent):void{
				if(currentScene==cityCanvas) return;
				sceneTweenEffect(currentScene,cityCanvas);
				currentScene=cityCanvas;
//				cityCanvas.visible = true;
//				worldPanel.visible = false;
//				strongholdPanel.visible = false;
			}
			
			/**
			 * 场景过渡效果
			 */
			private function sceneTweenEffect(oldScene:Canvas,newScene:Canvas):void{
				TweenMax.killAll(true);
				
				newScene.alpha=0.1;
				newScene.visible=true;
				oldScene.visible=true;
				TweenPlugin.activate([TransformMatrixPlugin]);
				TweenMax.to(oldScene,0.4,{ease:Circ.easeIn,alpha:0.1, transformMatrix:{tx:-1000,ty:-600,scaleX:3, scaleY:3},onComplete:onOldSceneComplete,onCompleteParams:[oldScene,newScene]});
				TweenMax.to(newScene,1,{alpha:1}); 
			}
			private function onOldSceneComplete(oldScene:Canvas,newScene:Canvas):void{
				oldScene.visible=false;
				TweenMax.to(oldScene,0.1,{ transformMatrix:{tx:0,ty:0,scaleX:1, scaleY:1} });
				bigContainer.setChildIndex(newScene,bigContainer.getChildIndex(oldScene));				
			} 
			
			//显示世界地图
			private function showMap(event:MouseEvent):void{
				if(currentScene==worldPanel)	return;
				sceneTweenEffect(currentScene,worldPanel);
				currentScene=worldPanel;
				//如果地图数据没有加载
				if(!mapLoad){
					trace("startTime:");
					trace(new Date().time);
//					model.worldInfo.loadMapData(model.cityInfo.posX,model.cityInfo.posY);
					worldPanel.callMapDataByCenterPoint(new Point(model.cityInfo.posX,model.cityInfo.posY),true);
					mapLoad = true;
				}
				
//				cityCanvas.visible = false;
//				strongholdPanel.visible = false;
//				worldPanel.visible = true;
			} 
			
