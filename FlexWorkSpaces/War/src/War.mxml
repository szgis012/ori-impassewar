				tooltip += "\n木材数量：" + formatTooltipNum(model.cityInfo.cityResource.woodNum);
				tooltip += "\n仓库容量：" + formatTooltipNum(model.cityInfo.cityResource.resourceNumMax);
				event.toolTip = new CommonTooltip(tooltip);
			}
			
