/**
* 任务编号: 8
*
* 要求：将伐木场与炼钢厂升级至3级。
* 奖励：木材1200，钢铁1200，食物700，石油700，金钱150。
* 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 4,5
def buildingIDs = [4,5];

// 1. 将伐木场升级至3级
if(context.getBuildingMaxLevel(buildingIDs[0]) > 2)
{
	result += "将伐木场升级至3级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "将伐木场升级至3级<a href='event:4'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 将炼钢厂升级至3级
if (context.getBuildingMaxLevel(buildingIDs[1]) > 2) 
{
	result += "将炼钢厂升级至3级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "将炼钢厂升级至3级<a href='event:5'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

if(count == 2)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材1200，钢铁1200，食物700，石油700，金钱150。
context.rewardResource(1200,1200,700,700,150);
}