/**
* 任务编号: 1043
*
* 要求：进行一次战斗，并保留您的战斗报告（无论胜负都能完成任务）
* 奖励：军火箱1个，小型集装箱1个，小型资金袋1个
* 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 1. 进行一次战斗
if(context.getPlayerAttackBattleLogNum() > 0)
{
	result = "进行一次战斗<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "进行一次战斗<font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：军火箱1个，小型集装箱1个，小型资金袋1个
context.rewardTreasure(442, 1);
context.rewardTreasure(445, 1);
context.rewardTreasure(448, 1);
}