/**
 * 任务编号:1009
 *
 * 要求：同时进行3个建造任务
 * 奖励：木材200，钢铁100，石油100，食物200，金钱100。
 * 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
 * 检查任务完成情况
 *
 */
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 1. 同时进行的建造任务数大于2
if(context.getCityBuildBuildingNum() > 2) 
{
	result += "同时进行3个建造任务<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "同时进行3个建造任务<font color='#ff0000'>[未完成]</font><br/>";
}

//如果完成了同时进行3个建造任务的任务
if (count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
 * 领取奖励
 *
 */
def doReceiveReward()
{
//奖励：木材200，钢铁100，石油100，食物200，金钱100
context.rewardResource(200,100,100,200,100);
}