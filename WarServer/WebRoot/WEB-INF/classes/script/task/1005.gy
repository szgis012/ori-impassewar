/**
 * 任务编号:1005
 *
 * 要求：征召10名市民。
 * 奖励：10名市民。
 * 后置任务：1006
 */
 
 
 //如果为领取奖励操作
if(context.getProcessType() == 1)
{
 	doReceiveReward();
}
else	//这里为检查任务完成情况的操作
{
 	return checkTask();
}
 
 
 /*
  * 检查任务完成情况
  *
  */
def checkTask()
{
 	//flag为0表示没有完成任务，flag=1表示完成了任务。
	def flag = 0;
	
	//返回结果
	def result = '';
	
	//如果最高市民数大于9，则任务完成。
	if(context.getEnlistCitizen() > 9)
	{
		flag = 1;
	}
	
	//如果完成了市民征召任务
	if(flag == 1)
	{
		result = "征召10名市民<font color='#00ff00'>[已完成]</font>";
	}
	
	else	//未完成市民征召任务
	{
		
		result = "征召10名市民<a href='event:1'><font color='#ffff00'><b>[点击征召]</b></font></a><font color='#ff0000'>[未完成]</font>";
	}
	
	//返回格式:任务是否完成标志+任务完成情况字符串
	return context.getEncodingText(flag+result);
 
}
 
 /*
  * 领取奖励
  *
  */
def doReceiveReward()
{
 	//奖励：10名市民。
 	context.rewardCitizen(10);
}