/**
 * 宝物编号:413
 * 
 * 名称：精致的保险箱
 * 描述：随机获得四至六种宝物
 * 类型：宝箱
 */

//出现的低,中,高级别宝物
int[] treasureList = [111,112,114,115,116,141,142,143,151,152,153,181,182,183,211,212,213,214,215,216,221,222,223,224,225,231,232,233,234,241,261,311,312,313,321,322,323,331,332,333,341,342,343,351,352,353,511,512,513,521,522,523,531,532,551,571,572,573,574,575,611,612,613,614,615,616,617,621,622,623,624,631,632,633,641,642,643,644,645,646,651,652,653,661,663,664,671,672,673];
String[] treasureName = ["巡逻队","征召命令","转移令","高级转移令","大喇叭","小型仓库","中型仓库","大型仓库","初级移民","中级移民","高级移民","军团扩建指令","士官军旗","校官军旗","建筑工","建筑队","建筑承包商","建筑技工","建筑师","高级建筑师","计算机","大型计算机","巨型计算机","超级计算机","量子计算机","初级流水线","中级流水线","高级流水线","超级流水线","运输队","征召令","轻型伐木机","中型伐木机","重型伐木机","小型熔炉","中型熔炉","巨型熔炉","小型炼化塔","中型炼化塔","巨型炼化塔","普通肥料","高效肥料","极效肥料","税吏","税收官员","税收总长","初级火药","中级火药","高级火药","初级护甲","中级护甲","高级护甲","战略欺骗","战略伪装","宣战文书","中立照会1","中立照会2","中立照会3","中立照会4","中立照会5","指挥实务","防护实务","思维实务","行政实务","调遣令","血战令","宣誓旗","重塑药水","再生药水","高级再生药水","军神药水","普通体力药剂","强效体力药剂","极效体力药剂","高卢战记","拿破仑传","装甲论","战争概论","战争详解","战争艺术","普通记忆胶囊","强效记忆胶囊","极效记忆胶囊","强运勋章(小)","血激勋章(小)","血激勋章(大)","战魂铜章","战魂银章","战魂金章"];
String[] imgs = ["111.png","112.png","114.png","115.png","116.png","141.png","142.png","143.png","151.png","152.png","153.png","181.png","182.png","183.png","211.png","212.png","213.png","214.png","215.png","216.png","221.png","222.png","223.png","224.png","225.png","231.png","232.png","233.png","234.png","241.png","261.png","311.png","312.png","313.png","321.png","322.png","323.png","331.png","332.png","333.png","341.png","342.png","343.png","351.png","352.png","353.png","511.png","512.png","513.png","521.png","522.png","523.png","531.png","532.png","551.png","571.png","572.png","573.png","574.png","575.png","611.png","612.png","613.png","614.png","615.png","616.png","617.png","621.png","622.png","623.png","624.png","631.png","632.png","633.png","641.png","642.png","643.png","644.png","645.png","646.png","651.png","652.png","653.png","661.png","663.png","664.png","671.png","672.png","673.png"];
StringBuffer retstr = new StringBuffer();
String dirName = "treasure";

//出现宝箱的个数4-6
int num = Math.random() * 10 % 3 + 4;
//出现的宝箱
int rnd;
//treasureID(宝物编号)
int tid;
//定义一个空Map对象(LinkedHashMap)
def map = [ : ];

for(int i=0; i<num; i++){
	rnd = Math.random() * 100 % treasureList.length;
	tid = treasureList[rnd];
	//给一个宝物
	context.rewardTreasure(tid,1);
	//如果宝物已经在列表中,就将其数量加一
	if(map[rnd]){
		map[rnd] = map[rnd] + 1;
	}else{
		map[rnd] =  1;
	}
}

//treasureName(宝物名称)
def tname;
def timg;

//遍历map
map.each{key,value ->
	tname = treasureName[key];
	timg = imgs[key];
	tid = treasureList[key];
	retstr.append("${tname}:${dirName}/${timg}:${value}:2:${tid}|");
}

return retstr.substring(0,retstr.length()-1);