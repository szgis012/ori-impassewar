/**
 * 宝物编号:417
 * 
 * 名称：战场功勋箱
 * 描述：获得：
		国家用来收藏战场功勋章的宝箱，里面装用各种战场功勋章。
		包含：
		初级战场功勋章
		高级战场功勋章
		特级战场功勋章
		
		70%开出其中一种，20%开出其中两种，10%开出其中3种
		若开出一种有80%开出2个，20%开出3个。
		若开出两种，80%每种一个，20%每种2个。
		若开出三种，每种为1个。


 * 类型：宝箱
 */

//出现的装备
String[] treasures = ["923:初级战场功勋章","924:高级战场功勋章","925:特级战场功勋章"];

String[] result = context.getBattleHonorBoxTreasure(treasures);

def treasureID;
def num;
def treasureName;
def image;

StringBuffer retstr = new StringBuffer();
String[] treasureInfo;

for(int i=0; i < result.length; i++){
	
	if (result[i] != null) {
		
		treasureInfo = result[i].split(":");
		
		treasureID = Integer.parseInt(treasureInfo[0]);
		num = Integer.parseInt(treasureInfo[2]);
		treasureName = treasureInfo[1];
		image = "treasure/" + treasureID + ".png";
		
		context.rewardTreasure(treasureID,num);
		retstr.append("${treasureName}:${image}:${num}:2:${treasureID}|");
		
	}
}

return retstr.substring(0,retstr.length()-1);