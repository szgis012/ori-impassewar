/**
 * 任务编号:1001
 *
 * 要求：领取新手礼包。
 * 奖励：新手礼包1。
 * 后置任务：1002
 */
 
// 如果为领取奖励操作
if (context.getProcessType() == 1) 
{
	doReceiveReward();
} 
else 	// 这里为检查任务完成情况的操作
{	
 	return checkTask();
}

/*
 * 检查任务完成情况
 *
 */
def checkTask()
{

 	// flag为0表示没有完成任务，flag=1表示完成了任务。
	def flag = 1;

	// 返回结果
	def result = "获得新手礼包1<font color='#00ff00'>[已完成]</font>";

	// 返回格式:任务是否完成标志+任务完成情况字符串
	return context.getEncodingText(flag+result); 
}
 
/*
 * 领取奖励
 *
 */
def doReceiveReward() 
{
 	// 奖励：新手礼包1
 	context.rewardTreasure(421, 1);
}
