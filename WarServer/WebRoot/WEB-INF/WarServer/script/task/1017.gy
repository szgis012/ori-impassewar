/**
 * 任务编号:1017
 *
 * 要求：城市中心升至2级并使用道具“建筑工”
 * 奖励：木材800，钢铁600，食物600，石油500，金钱120，建筑工*2。
 * 后置任务：1018
 */


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
 * 检查任务完成情况
 *
 */
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为1
def buildingID = 1;

// 宝物编号
def treasureID = 211;


// 1. 使用道具“建筑工”
if(context.hasUsedTreasure(treasureID)) 
{
	result += "使用道具“建筑工”<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "使用道具“建筑工”<font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 升级城市中心
if(context.getBuildingMaxLevel(buildingID) > 1)
{
	result += "将城市中心升级至2级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result +=	"将城市中心升级至2级<a href='event:1'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

//如果完成了城市中心升至2级并使用道具“建筑工”的任务
if (count == 2)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
 * 领取奖励
 *
 */
def doReceiveReward()
{
//奖励：木材800，钢铁600，食物600，石油500，金钱120，建筑工*2
context.rewardResource(800,600,500,600,120);
context.rewardTreasure(211, 2);
}