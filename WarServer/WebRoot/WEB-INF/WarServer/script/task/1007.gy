/**
* 任务编号:1007
*
* 要求：使用道具“征召令”。
* 奖励：征召令×2。
* 后置任务：1008
*/


// 如果为领取奖励操作
if(context.getProcessType() == 1)
{
doReceiveReward();
}
else	//这里为检查任务完成情况的操作
{
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
// flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物编号为 261
def treasureID = 261;

// 1. 使用道具“征召令”
if (context.hasUsedTreasure(261)) 
{
	result = "使用道具“征召令”<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "使用道具“征召令”</a><font color='#ff0000'>[未完成]</font><br/>";
}

//如果完成了征召40名市民，并使用道具“征召令”的任务
if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
//奖励：征召令×2
context.rewardTreasure(261, 2);
}
