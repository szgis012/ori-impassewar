/**
* 任务编号: 75
*
* 要求：建造10级仓库
* 奖励：木材12000，钢铁10000，石油6000，食物3500，金钱1500
* 后置任务：76
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 3
def buildingID = 3;

// 1. 建造10级仓库
if(context.getBuildingMaxLevel(buildingID) > 9)
{
	result = "建造10级仓库<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "建造10级仓库<a href='event:3'><font color='#ffff00'><b>[点击进入仓库]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材12000，钢铁10000，石油6000，食物3500，金钱1500
context.rewardResource(12000,10000,6000,3500,1500);
}