/**
* 任务编号: 80
*
* 要求：声望200，金钱2000，★铜质战功章×2.
* 奖励：军衔：一等兵
* 后置任务：81
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
	doReceiveReward();
}else{
//这里为检查任务完成情况的操作
	return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物编号为 914
def treasureID = 914;

// 1. 声望200
if(context.getRenown() > 199)
{
	result += "声望200<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "声望200<font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 金钱2000
if(context.getMoneyNum() > 1999)
{
	result += "金钱2000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "金钱2000<font color='#ff0000'>[未完成]</font><br/>";
}

// 3. ★铜质战功章×2
if(context.getPlayerTreasureNum(treasureID) > 1)
{
	result += "★铜质战功章×2<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "★铜质战功章×2<font color='#ff0000'>[未完成]</font><br/>";
}

if(count == 3)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	// 奖励：军衔：一等兵
	context.updateHonor(2);
	context.rewardTreasure(411,1);
	
	// 减去消耗物品
	context.reduceMoneyNum(2000);
	context.reduceTreasure(914,2);
}