/**
* 任务编号: 4005
*
* 要求：收集“★★白银战功章”×3
* 奖励：★★黄金战功章×1
* 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物标号
def treasureID = 918;

// 1. 收集“★★白银战功章”×3
if(context.getPlayerTreasureNum(treasureID) > 2)
{
	result = "收集“★★白银战功章”×3<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "收集“★★白银战功章”×3<font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 1)
{
	flag = 1;
}

// 返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：★★黄金战功章×1
context.exchangeTreasure(918, 3, 919, 1);
}