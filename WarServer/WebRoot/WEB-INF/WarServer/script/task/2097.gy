/**
* 任务编号: 97
*
* 要求：声望100w，金钱1000w，国家名誉章×3，国家荣誉章×5
* 奖励：军衔：元帅
* 后置任务：98
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物编号
def treasureIDs = [929,930];

// 1. 声望100w
if(context.getRenown() > 999999)
{
	result += "声望1000000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "声望1000000<font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 金钱1000w
if(context.getMoneyNum() > 9999999)
{
	result += "金钱10000000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "金钱10000000<font color='#ff0000'>[未完成]</font><br/>";
}

// 3. 国家名誉章×3
if(context.getPlayerTreasureNum(treasureIDs[0]) > 2)
{
	result += "国家名誉章×3<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "国家名誉章×3<font color='#ff0000'>[未完成]</font><br/>";
}

// 4. 国家荣誉章×5
if(context.getPlayerTreasureNum(treasureIDs[1]) > 4)
{
	result += "国家荣誉章×5<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "国家荣誉章×5<font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 4)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	// 奖励：军衔：元帅
	context.updateHonor(19);
	context.rewardTreasure(413,1);
	
	// 减去消耗物品
	context.reduceMoneyNum(10000000);
	context.reduceTreasure(929,3);
	context.reduceTreasure(930,5);
}