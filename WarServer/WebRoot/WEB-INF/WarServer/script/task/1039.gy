/**
* 任务编号: 1039
*
* 要求：生产步枪10支，并使用【初级流水线】加速。
* 奖励：步枪10支，初级流水线×2.
* 后置任务：1040
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 军械编号为
def ordnanceID = 1;

// 宝物编号为
def treasureID = 231;

// 1. 生产步枪10支
if(context.getCityOrdnanceNum(ordnanceID) > 9)
{
	result += "生产步枪10支<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result += "生产步枪10支<a href='event:13'><font color='#ffff00'><b>[点击生产]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

// 2. 使用【初级流水线】加速
if(context.hasUsedTreasure(treasureID))
{
	result += "使用初级流水线<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result += "使用初级流水线<font color='#ff0000'>[未完成]</font>";
}

if(count == 2)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	// 奖励：步枪10支
	context.rewardOrdnance(1, 10);
	// 奖励：初级流水线×2
	context.rewardTreasure(231,2);
}