/**
* 任务编号:3003
*
* 任务：100战俘
* 奖励：声望：1000，金钱：5000，战魂铜章×1
* 后置任务:2103
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

//返回结果
def result = '';

//获得战俘的数量
def treasureNum = context.getPlayerTreasureNum(913);

if(treasureNum>=100)
{
	flag = 1;
}

if(flag == 1)
{
	result = "<font color='#00ff00'>需要收集：战俘(${treasureNum}/100)</font>";
}
else
{

	result = "<font color='#ff0000'>需要收集：战俘(${treasureNum}/100)</font>";
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	context.minusTreasure(913,100);
	context.rewardRenown(1000);
	context.rewardResource(0,0,0,0,5000);
	context.rewardTreasure(671,1);
}