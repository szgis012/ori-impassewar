/**
* 任务编号: 1041
*
* 要求：通过军队编制为一名指挥官分配部队
* 奖励：木材100，钢铁100，石油100，食物100，金钱100
* 后置任务：1042,1044,1048
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 兵种编号为
def armyID = 1;

// 1. 通过军队编制为一名指挥官分配部队
if(context.getHasArmyCityMilitaryNum() > 0)
{
	result = "通过军队编制为一名指挥官分配部队<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "通过军队编制为一名指挥官分配部队<a href='event:11'><font color='#ffff00'><b>[点击编制]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材100，钢铁100，石油100，食物100，金钱100
context.rewardResource(100, 100, 100, 100, 100);
}