/**
* 任务编号: 93
*
* 要求：声望10w，金钱100w，军团名誉章×3
* 奖励：军衔：准将
* 后置任务：94
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物编号
def treasureID = 926 ;

// 1. 声望10w
if(context.getRenown() > 99999)
{
	result += "声望100000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "声望100000<font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 金钱100w
if(context.getMoneyNum() > 999999)
{
	result += "金钱1000000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "金钱1000000<font color='#ff0000'>[未完成]</font><br/>";
}

// 3. 军团名誉章×3
if(context.getPlayerTreasureNum(treasureID) > 2)
{
	result += "军团名誉章×3<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "军团名誉章×3<font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 3)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	// 奖励：军衔：准将
	context.updateHonor(15);
	context.rewardTreasure(412,1);
	
	// 减去消耗物品
	context.reduceMoneyNum(1000000);
	context.reduceTreasure(926,3);
}