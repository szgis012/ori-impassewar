/**
 * 任务编号:1012
 *
 * 要求：建造1座1级油井，并派遣10名市民。
 * 奖励：石油100，市民10。
 * 后置任务：--
*/


// 如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}
else	//这里为检查任务完成情况的操作
{
return checkTask();
}


/*
 * 检查任务完成情况
 *
*/
def checkTask()
{
// flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为6
def buildingID = 6;

// 建造1座1级油井	
if(context.getBuildingMaxLevel(buildingID) > 0)
{
	result = "建造1座1级油井<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "建造1座1级油井<a href='event:6'><font color='#ffff00'><b>[点击建造]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}


//如果向油井派遣9名以上市民，就算完成任务。
if(context.getOilWorkerNum()>9)
{
	result += "向油井派遣10名市民<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "向油井派遣10名市民<a href='event:6'><font color='#ffff00'><b>[点击派遣]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}


//如果完成了建造油井以及派遣市民的任务
if(count == 2)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
 * 领取奖励
 *
*/
def doReceiveReward()
{
//奖励：石油100，市民10
context.rewardResource(0,0,100,0,0);
context.rewardCitizen(10);
}
