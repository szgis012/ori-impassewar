/**
* 任务编号: 1031
*
* 要求：招募一名指挥官。
* 奖励：指挥官装备盒，征召命令*1
* 后置任务：1032
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 1. 招募一名指挥官
if(context.getCityHeroNum() > 0)
{
	result = "招募一名指挥官<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "招募一名指挥官<a href='event:10'><font color='#ffff00'><b>[点击招募]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
//奖励：指挥官装备盒，征召命令*1
context.rewardTreasure(451, 1);	
context.rewardTreasure(112, 1);
}