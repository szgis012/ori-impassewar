/**
* 任务编号: 21
*
* 要求：领取军团补贴
* 奖励：木材50，钢铁50，石油50，食物50，金钱50
* 后置任务：50
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 1. 领取军团补贴
if(context.hasReceivedSubsidy())
{
	result = "领取军团补贴<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "领取军团补贴<font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材50，钢铁50，石油50，食物50，金钱50
context.rewardResource(50,50,50,50,50);
}