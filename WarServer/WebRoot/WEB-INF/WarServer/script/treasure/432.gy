/**
 * 宝物编号:432
 * 
 * 名称： 白金卡
 * 描述：获得
					陈旧储物箱*10
					高级火药*1
					高级护甲*1
					战略欺骗*1
					战略伪装*1
					装甲论*1
					中立照会1*1
 * 类型：宝箱
 */

//出现的宝物
int[] treasureList =  [441,513,523,531,532,643,572];
String[] treasureName = ["陈旧储物箱",  " 高级火药", "高级护甲","战略欺骗","战略伪装","装甲论","中立照会2" ];
String[] imgs = ["441.png","513.png", "523.png", "531.png", "532.png", "643.png", "572.png"];
int[] treasureNum = [10,1,1,1,1,1,1];
String dirName = "treasure";

StringBuffer retstr = new StringBuffer();

for(int i=0; i<treasureList.length; i++){
	context.rewardTreasure(treasureList[i],treasureNum[i]);
	retstr.append("${treasureName[i]}:${dirName}/${imgs[i]}:${treasureNum[i]}|");
}

return retstr.substring(0,retstr.length()-1);