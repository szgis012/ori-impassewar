/**
 * 宝物编号:421
 * 
 * 名称：新手宝箱1
 * 描述：获得：
					轻型伐木机*1
					小型熔炉*1
					小型炼化塔*1
					普通肥料*1
					建筑工*3
					建筑队*1
					征召命令*3
					转移令*1
					初级移民*1
					运输队*1
					征召令*2
					初级流水线*2
					计算机*2
					大喇叭*40
					新手礼包2*1
 * 类型：宝箱
 */

//出现的宝物
int[] treasureList = [311, 321, 331, 341, 211, 212, 112, 114, 151, 241, 261, 231, 221, 116, 422];
String[] treasureName = ["轻型伐木机", "小型熔炉", "小型炼化塔", "普通肥料", "建筑工", "建筑队", "征召命令", "转移令", "初级移民", "运输队", "征召令", "初级流水线", "计算机", "大喇叭", "新手礼包2"];
String[] imgs = ["311.png", "321.png", "331.png", "341.png", "211.png", "212.png", "112.png", "114.png", "151.png", "241.png", "261.png", "231.png", "221.png", "116.png", "422.png"];
int[] treasureNum = [1, 1, 1, 1, 3, 1, 3, 1, 1, 1, 2, 2, 2, 20, 1];
String dirName = "treasure";

StringBuffer retstr = new StringBuffer();

for(int i=0; i<treasureList.length; i++){
	context.rewardTreasure(treasureList[i],treasureNum[i]);
	retstr.append("${treasureName[i]}:${dirName}/${imgs[i]}:${treasureNum[i]}|");
}

return retstr.substring(0,retstr.length()-1);