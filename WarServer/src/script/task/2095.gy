/**
* 任务编号: 95
*
* 要求：声望30w，金钱300w，黄金军团名誉章×3，钻石军团名誉章×2
* 奖励：军衔：中将
* 后置任务：96
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 宝物编号
def treasureIDs = [927,928];

// 1. 声望30w
if(context.getRenown() > 299999)
{
	result += "声望300000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "声望300000<font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 金钱300w
if(context.getMoneyNum() > 2999999)
{
	result += "金钱3000000<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "金钱3000000<font color='#ff0000'>[未完成]</font><br/>";
}

// 3. 黄金军团名誉章×3
if(context.getPlayerTreasureNum(treasureIDs[0]) > 2)
{
	result += "黄金军团名誉章×3<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "黄金军团名誉章×3<font color='#ff0000'>[未完成]</font><br/>";
}

// 4. 钻石军团名誉章×2
if(context.getPlayerTreasureNum(treasureIDs[1]) > 1)
{
	result += "钻石军团名誉章×2<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "钻石军团名誉章×2<font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 4)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
	// 奖励：军衔：中将
	context.updateHonor(17);
	context.rewardTreasure(412,1);
	
	// 减去消耗物品
	context.reduceMoneyNum(3000000);
	context.reduceTreasure(927,3);
	context.reduceTreasure(928,2);
}