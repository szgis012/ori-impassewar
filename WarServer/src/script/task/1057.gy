/**
* 任务编号: 1057
*
* 要求：将指挥中心升级至3级。
* 奖励：木材1000，钢铁800，食物800，石油800，金钱800。	
* 后置任务：完成该任务后触发成长任务1，7，80，109，122
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
// flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 11
def buildingID = 11;

// 1. 将指挥中心升级至3级
if(context.getBuildingMaxLevel(buildingID) > 2)
{
	result = "将指挥中心升级至3级<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "将指挥中心升级至3级<a href='event:11'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材1000，钢铁800，食物800，石油800，金钱800。	
context.rewardResource(1000,800,800,800,800);
}