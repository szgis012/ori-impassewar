/**
 * 任务编号:1015
 *
 * 要求：建造1级仓库1座。
 * 奖励：木材700，钢铁400，石油120，食物400，金钱100。
 * 后置任务：1016
 */


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
 * 检查任务完成情况
 *
 */
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

//返回结果
def result = '';

//建筑编号为3
def buildingID = 3;

//建造1级仓库1座。
if(context.getBuildingMaxLevel(buildingID) > 0){
	flag = 1;
}

//如果完成了建造仓库的任务

if(flag == 1)
{
	result = "建造1座1级仓库<font color='#00ff00'>[已完成]</font>";
}

else
{
	//未完成建造仓库的任务
	result = "建造1座1级仓库<a href='event:3'><font color='#ffff00'><b>[点击建造]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
 * 领取奖励
 *
 */
def doReceiveReward()
{
//奖励：木材700，钢铁400，石油120，食物400，金钱100。
context.rewardResource(700,400,120,400,100);
}