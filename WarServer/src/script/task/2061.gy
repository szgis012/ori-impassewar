/**
* 任务编号: 61
*
* 要求：指挥中心升至20级
* 奖励：木材80w，钢铁70w，石油40w，食物70w，金钱15w
* 后置任务：62
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 11
def buildingID = 11;

// 1. 指挥中心升至20级
if(context.getBuildingMaxLevel(buildingID) > 19)
{
	result = "指挥中心升至20级<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "指挥中心升至20级<a href='event:11'><font color='#ffff00'><b>[点击进入指挥中心]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材80w，钢铁70w，石油40w，食物70w，金钱15w
context.rewardResource(800000,700000,400000,700000,150000);
}