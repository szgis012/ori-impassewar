/**
* 任务编号: 111
*
* 要求：突击兵100
* 奖励：突击兵100
* 后置任务：112
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 兵种编号为 3
def armyID = 3;

// 1. 突击兵100
if(context.getCityArmyNum(armyID) > 99)
{
	result = "突击兵100<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "突击兵100<a href='event:13'><font color='#ffff00'><b>[点击进入兵工厂]</b></font></a><a href='event:14'><font color='#ffff00'><b>[点击进入兵营]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：突击兵100
context.rewardCityArmy(3, 100);
}