/**
* 任务编号: 69
*
* 要求：木材厂10级，炼钢厂10级，油井10级, 农场10级
* 奖励：木材30000，钢铁30000，石油20000，食物10000，金钱30000
* 后置任务：70
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 4,5,6,7
def buildingIDs = [4,5,6,7];

// 1. 木材厂10级
if(context.getBuildingMaxLevel(buildingIDs[0]) > 9)
{
	result += "木材厂10级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "木材厂10级<a href='event:4'><font color='#ffff00'><b>[点击进入木材厂]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 炼钢厂10级
if(context.getBuildingMaxLevel(buildingIDs[1]) > 9)
{
	result += "炼钢厂10级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "炼钢厂10级<a href='event:5'><font color='#ffff00'><b>[点击进入炼钢厂]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

// 3. 油井10级
if(context.getBuildingMaxLevel(buildingIDs[2]) > 9)
{
	result += "油井10级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "油井10级<a href='event:6'><font color='#ffff00'><b>[点击进入油井]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}	

// 4. 农场10级
if(context.getBuildingMaxLevel(buildingIDs[3]) > 9)
{
	result += "农场10级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "农场10级<a href='event:7'><font color='#ffff00'><b>[点击进入农场]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}	


if(count == 4)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材30000，钢铁30000，石油20000，食物10000，金钱30000
context.rewardResource(30000,30000,20000,10000,30000);
}