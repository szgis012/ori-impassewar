/**
* 任务编号: 1022
*
* 要求：使用“运输队”加速购买资源
* 奖励：运输队×2
* 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

def treasureID = 241;

// 1. 使用“运输队”加速购买资源
if(context.hasUsedTreasure(treasureID))
{
	result += "使用“运输队”加速购买资源<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result += "使用“运输队”加速购买资源<font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
//奖励：运输队×2
context.rewardTreasure(241, 2);
}