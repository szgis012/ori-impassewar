/**
* 任务编号: 1052
*
* 要求：制造重机枪5挺。
* 奖励：重机枪5挺。
* 后置任务：1053
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
	doReceiveReward();
}else{
//这里为检查任务完成情况的操作
	return checkTask();
}


/*
 * 检查任务完成情况
 *
 */
def checkTask()
{
	//flag为0表示没有完成任务，flag=1表示完成了任务。
	def flag = 0;
	
	// 记录完成的条件 
	def count = 0;
	
	// 返回结果
	def result = '';
	
	// 军械编号为 2
	def ordnanceID = 2;
	
	// 1. 制造重机枪5挺
	if(context.getCityOrdnanceNum(ordnanceID) > 4)
	{
		result = "制造重机枪5挺<font color='#00ff00'>[已完成]</font><br/>";
		count++;
	}
	else
	{
		result = "制造重机枪5挺<a href='event:13'><font color='#ffff00'><b>[点击生产]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
	}
	
	if(count == 1)
	{
		flag = 1;
	}
	
	//返回格式:任务是否完成标志+任务完成情况字符串
	return context.getEncodingText(flag+result);

}

/*
 * 领取奖励
 *
 */
def doReceiveReward()
{
	// 重机枪×5
	context.rewardOrdnance(2, 5);
}