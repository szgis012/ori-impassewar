/**
* 任务编号: 9
*
* 要求：将农场与油井升级至3级
* 奖励：木材700，钢铁700，食物1200，石油1200，金钱200。
* 后置任务：69，20
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 建筑编号为 6,7
def buildingIDs = [6,7];

// 1. 将油井升至3级
if(context.getBuildingMaxLevel(buildingIDs[0]) > 2)
{
	result += "将油井升至3级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "将油井升至3级<a href='event:6'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

// 2. 将农场升级至3级
if (context.getBuildingMaxLevel(buildingIDs[1]) > 2) 
{
	result += "将农场升级至3级<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result += "将农场升级至3级<a href='event:7'><font color='#ffff00'><b>[点击升级]</b></font></a><font color='#ff0000'>[未完成]</font><br/>";
}

if(count == 2)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：木材700，钢铁700，食物1200，石油1200，金钱200。
context.rewardResource(700,700,1200,1200,200);
}