/**
* 任务编号: 6
*
* 要求：修改城市名称
* 奖励：金钱200
* 后置任务：--
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 1. 修改城市名称
if(context.hasPerformTheOperation(com.war.constant.OperationLogConstant.CHANGE_CITY_NAME))
{
	result = "修改城市名称<font color='#00ff00'>[已完成]</font>";
	count++;
}
else
{
	result = "修改城市名称<a href='event:1'><font color='#ffff00'><b>[点击修改]</b></font></a><font color='#ff0000'>[未完成]</font>";
}

if(count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：金钱200
context.rewardResource(0,0,0,0,200);
}