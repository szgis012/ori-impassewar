/**
* 任务编号: 132
*
* 要求：消灭5级中立军队
* 奖励：声望：1500，★白银战功章
* 后置任务：133
*/


//如果为领取奖励操作
if(context.getProcessType() == 1){
doReceiveReward();
}else{
//这里为检查任务完成情况的操作
return checkTask();
}


/*
* 检查任务完成情况
*
*/
def checkTask()
{
//flag为0表示没有完成任务，flag=1表示完成了任务。
def flag = 0;

// 记录完成的条件 
def count = 0;

// 返回结果
def result = '';

// 目标等级
def level = 5;

// 1. 消灭5级中立军队
if(context.hasCompleteAttackForSpecifyLevel(level, new Date(0)))
{
	result = "消灭5级中立军队<font color='#00ff00'>[已完成]</font><br/>";
	count++;
}
else
{
	result = "消灭5级中立军队<font color='#ff0000'>[未完成]</font><br/>";
}

if (count == 1)
{
	flag = 1;
}

//返回格式:任务是否完成标志+任务完成情况字符串
return context.getEncodingText(flag+result);

}

/*
* 领取奖励
*
*/
def doReceiveReward()
{
// 奖励：声望：1500，★白银战功章
context.rewardRenown(1500);
context.rewardTreasure(915, 1);
}